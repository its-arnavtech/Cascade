# Cascade local live-demo placeholders.
# Copy to .env.live-demo only when intentionally testing bounded real actions on a local kind cluster.
# Do not commit real local overrides.

ENABLE_DANGEROUS_ACTIONS=false
ENABLE_REAL_CHAOS=false
ENABLE_REAL_REMEDIATION=false
CASCADE_LIVE_DEMO_MODE=false
CASCADE_ALLOWED_CLUSTER_CONTEXT=kind-cascade
CASCADE_ACTIVE_CLUSTER_CONTEXT=kind-cascade
CASCADE_ALLOWED_TARGET_NAMESPACE=cascade-targets
CASCADE_REQUIRE_APPROVAL=true
CASCADE_REQUIRE_DRY_RUN_FIRST=true
CASCADE_AUTH_ENABLED=false
CASCADE_LOCAL_DEMO_AUTH_BYPASS=false
CASCADE_API_KEYS=
CASCADE_API_KEY_HASHES=
CASCADE_AUTH_HEADER=Authorization
CASCADE_APPROVAL_SIGNING_SECRET=
