{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade.local/schemas/telemetry_raw.schema.json",
  "title": "Cascade Telemetry Raw Event",
  "description": "Raw pod/service telemetry event produced by observation-service from normalized Prometheus snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "namespace",
    "pod_name",
    "service_name",
    "cpu",
    "memory",
    "restart_count",
    "pod_phase",
    "source"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "pod_name": {
      "type": "string",
      "minLength": 1
    },
    "service_name": {
      "type": ["string", "null"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "cpu": {
      "type": ["number", "null"],
      "description": "CPU usage in cores."
    },
    "memory": {
      "type": ["number", "null"],
      "description": "Memory working set in bytes."
    },
    "restart_count": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "pod_phase": {
      "type": ["string", "null"]
    },
    "ready": {
      "type": ["boolean", "null"]
    },
    "request_rate": {
      "type": ["number", "null"]
    },
    "error_rate": {
      "type": ["number", "null"]
    },
    "latency_p50_ms": {
      "type": ["number", "null"]
    },
    "latency_p95_ms": {
      "type": ["number", "null"]
    },
    "latency_p99_ms": {
      "type": ["number", "null"]
    },
    "warning_event_count": {
      "type": ["number", "null"]
    },
    "service_available": {
      "type": ["boolean", "null"]
    },
    "redpanda_healthy": {
      "type": ["boolean", "null"]
    },
    "clickhouse_healthy": {
      "type": ["boolean", "null"]
    },
    "qdrant_healthy": {
      "type": ["boolean", "null"]
    },
    "missing_metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "collection_warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metric_status": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "evidence_quality": {
      "type": "string"
    },
    "used_kubernetes_fallback": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "const": "observation-service"
    }
  }
}
